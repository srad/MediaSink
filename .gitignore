# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Locally installed ONNX runtime (./server/install-onnxruntime.sh)
/server/lib/

# Virtualenv used to export the ONNX model (./server/install-model.sh)
/server/.venv-export/

# Python bytecode from the model export script
__pycache__/
*.py[cod]

# ONNX external-weight sidecars. The committed model is self-contained (the
# export asserts this); a stray .onnx.data is a ~120 MB leftover, never an asset.
*.onnx.data

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
*.sqlite
*.sqlite3
.idea
.code
app.yml
main
main.exe
restart_service.sh
ffmpeg
/recordings
.previews
rename.sh
/server/docs/swagger.yaml
/server/docs/swagger.json
/server/docs/docs.go
/server/frontend/dist/*
!/server/frontend/dist/.gitkeep
bin
.env
mediasink
.runtime
.codex-reference
